# Server
PORT=3001
HOST=127.0.0.1
# For remote HTTPS hosting, set APP_ORIGIN to your public URL.
# Set COOKIE_SECURE=true with HTTPS; TRUST_PROXY=true only behind a trusted proxy.
APP_ORIGIN=http://127.0.0.1:5173
COOKIE_SECURE=false
TRUST_PROXY=false

# MySQL: create this database and dedicated user before running migrations.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=job_tracker
DB_PASSWORD=replace-with-your-database-password
DB_NAME=job_tracker
SESSION_SECRET=replace-with-a-long-random-secret
ENCRYPTION_KEY=replace-with-a-separate-long-random-secret

# Optional: configure AI here or later through Settings.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=
AI_API_KEY=

# Optional: override Puppeteer's downloaded browser with an installed Chromium.
# PUPPETEER_EXECUTABLE_PATH=/absolute/path/to/chromium
# STORAGE_DIR=storage
# TEST_DB_NAME=job_tracker_test
# TEST_BROWSER_PATH=/absolute/path/to/chromium
