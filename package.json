{
  "name": "job-application-tracker",
  "version": "1.0.0",
  "description": "Self-hosted career profile, application preparation, and job tracking workspace",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build --config client/vite.config.js",
    "start": "node --env-file-if-exists=.env server/src/server.js",
    "db:migrate": "node --env-file-if-exists=.env server/src/lib/migrate.js",
    "test": "node --env-file-if-exists=.env --test server/tests/*.test.js client/src/features/dashboard/analytics.test.js client/src/features/preparation/draft.test.js client/src/features/preparation/resume.test.js",
    "test:e2e": "playwright test",
    "test:db": "node scripts/test-db.mjs",
    "db:local": "node scripts/mysql-local.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "express": "^5.3.0",
    "lucide-react": "^1.65.0",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "pdfjs-dist": "^6.4.299",
    "puppeteer": "^25.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  }
}
